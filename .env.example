# Environment Variables - Backend Configuration
# Copy this to .env and fill in your actual credentials

# ============================================
# Supabase Configuration
# ============================================

# Go to https://supabase.com
# Create a project and get these from Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================
# Cloudflare R2 Configuration
# ============================================

# Go to https://dashboard.cloudflare.com
# Create R2 bucket and API token
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-access-key-id
CLOUDFLARE_R2_SECRET_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET=divine-grace-storage
CLOUDFLARE_R2_PUBLIC_URL=https://divine-grace-storage.your-domain.r2.cloudflarestorage.com

# ============================================
# Server Configuration
# ============================================

PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# ============================================
# Email Configuration (Optional - for future use)
# ============================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SENDER_EMAIL=noreply@divinegraceunnumm.com
